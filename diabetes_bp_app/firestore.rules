rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (requires the Firebase CLI and firebase.json, see README.md)
//
// A patient can only read/write documents nested under their own
// users/{uid} document. This is what makes "each patient only sees
// their own data" actually enforced, not just a UI convention.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /medications/{medicationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /glucoseReadings/{readingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /bpReadings/{readingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /medicationLogs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /symptomLogs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
